{
  "Plc": {
    "Host": "192.168.1.100",
    "Port": 502,
    "UnitId": 1,
    "StartAddress": 12288,
    "EndAddress": 16383,
    "BlockSize": 122,
    "PollIntervalMs": 100,
    "TimeoutMs": 3000,
    "RegisterMapCsv": "registers.csv",
    "RegisterMapType": "Csv"
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=smartmix;User=root;Password=password;Pooling=true;",
    "MaxPoolSize": 100,
    "CommandTimeout": 30,
    "EnableRetry": true,
    "MaxRetryAttempts": 3
  },
  "Logging": {
    "LogLevel": "Information",
    "LogPath": "logs",
    "RetainDays": 30,
    "MaxFileSizeBytes": 100000000,
    "EnableConsole": true,
    "EnableFile": true
  },
  "Line": {
    "LineNumber": 1,
    "Name": "Line 1",
    "MixerCount": 2,
    "DoserCount": 4,
    "SkipCount": 1,
    "AccumulatorCount": 1,
    "BunkerCount": 12,
    "EnableAutoStart": false
  },
  "License": {
    "SerialNumber": "",
    "AutoActivate": false,
    "CheckIntervalHours": 24
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/smartmix-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 100000000
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}